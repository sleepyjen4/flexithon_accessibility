# Gemini (build-time only — read solely by scripts/generate-audio.ts to
# pre-generate exercise instruction audio. Nothing calls a model at runtime:
# workouts are built deterministically by lib/workoutBuilder.ts.)
GEMINI_API_KEY=

# Google Cloud TTS (build-time fallback — used if Gemini is unset or fails)
# A Google Cloud API key with the "Cloud Text-to-Speech API" enabled.
GOOGLE_TTS_API_KEY=
# Optional voice overrides (default: en-US-Neural2-F, a warm female en-US voice)
GOOGLE_TTS_VOICE=
GOOGLE_TTS_LANGUAGE_CODE=
# Optional: force a provider — gemini | google (default: try Gemini, then Google)
TTS_PROVIDER=

