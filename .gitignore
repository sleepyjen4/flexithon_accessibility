# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# puppeteer captures (npm run screenshots) — uploaded to the pr-screenshots branch, never committed here
/.screenshots/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# editor local-history snapshots
.history/

# local agent tooling
.claude/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template the README tells you to copy
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
